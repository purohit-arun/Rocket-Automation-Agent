# ─── OpenAI Configuration ───
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o

# ─── Rocket.new Configuration ───
BASE_URL=https://rocket.new

# Path to the saved browser auth state (Google login session)
# Generated by running: npx ts-node src/scripts/saveAuthState.ts
AUTH_STATE_PATH=./auth/storageState.json

# ─── Storage Configuration ───
# Path to the CSV output file (relative to project root)
CSV_OUTPUT_PATH=./output/app_definitions.csv

# ─── Automation Settings ───
# Number of retries for flaky operations
MAX_RETRIES=3
# Delay between retries in ms
RETRY_DELAY_MS=2000
# Headed or headless browser
HEADLESS=false
